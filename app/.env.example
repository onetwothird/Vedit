# Copy to .env.local and fill in from Supabase: Project Settings > API Keys.
# The publishable key is meant to ship inside the app; never put a secret (sb_secret_) key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Sync with the website (desktop app): the cloud engine's address (the Modal URL). Unset = no sync, the app works
# on its own as before.
# VITE_CLOUD_URL=https://your-workspace--vedit-api.modal.run
