{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: open dialog, exit/restart, updater. No shell access: Rust spawns the engine.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "process:allow-exit",
    "process:allow-restart",
    "updater:default"
  ]
}
