{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: open dialog, exit/restart, updater, vedit:// sign-in links, opening the sign-in page in the browser. No shell access: Rust spawns the engine.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "process:allow-exit",
    "process:allow-restart",
    "updater:default",
    "deep-link:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://*.supabase.co/auth/v1/authorize*"
        }
      ]
    }
  ]
}
