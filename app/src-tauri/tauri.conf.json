{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Vedit Studio",
  "version": "0.1.0",
  "identifier": "studio.vedit.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Vedit Studio",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; media-src 'self' asset: http://asset.localhost http://127.0.0.1:*; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:* https://*.supabase.co; img-src 'self' asset: http://asset.localhost http://127.0.0.1:* data: https://*.googleusercontent.com https://*.fbsbx.com https://*.fbcdn.net; font-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "engine/": "engine/",
      "ffmpeg/": "bin/"
    },
    "publisher": "Vedit",
    "copyright": "Copyright (c) Vedit contributors. MIT License.",
    "category": "Video",
    "shortDescription": "Turn long videos into ready-to-post clips",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English"
        ]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc0RjRBM0FFQTQyRjk0MUUKUldRZWxDK2tycVAwZENjZDIza0E3bWZFTTE5Z3JCdnhWZ0dCSUNFQVZiTDl3cWdjVnZzV1g0R3cK",
      "endpoints": [
        "https://github.com/onetwothird/vedit/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "vedit"
        ]
      }
    }
  }
}
