# Web build (the website): the engine is the cloud API and the user signs in with Supabase.
VITE_ENGINE=cloud
VITE_ENGINE_URL=
VITE_SUPABASE_URL=
# Only the publishable key (sb_publishable_...) belongs here, never an sb_secret_ key: this file ends up in the browser bundle.
VITE_SUPABASE_PUBLISHABLE_KEY=
