  {"w0": 153, "w1": 163, "start": 69.246, "end": 73.434, "text": "Naglakad kami pauwi habang kumakain ng tinapay sa daan pauwi namin."},
  {"w0": 164, "w1": 175, "start": 73.877, "end": 78.448, "text": "Pagkatapos kumain nagpahinga kami sa ilalim ng puno ng mangga sa likod."},
  {"w0": 176, "w1": 186, "start": 78.892, "end": 83.059, "text": "Nandito ako ngayon sa palengke malapit sa bahay namin sa probinsya."},
  {"w0": 187, "w1": 198, "start": 83.523, "end": 88.092, "text": "Pagdating sa bahay nagluto agad si lola ng sinigang para sa lahat."},
  {"w0": 199, "w1": 210, "start": 88.538, "end": 93.113, "text": "Nag picnic kami sa tabi ng ilog at nagkuwentuhan buong hapon doon."},
