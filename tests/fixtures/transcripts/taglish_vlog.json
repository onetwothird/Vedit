 "sentences": [
  {"w0": 0, "w1": 12, "start": 0.0, "end": 4.938, "text": "Simple lang ang buhay dito pero masaya ang lahat ng tao sa paligid."},
  {"w0": 13, "w1": 24, "start": 5.4, "end": 9.986, "text": "Mamaya pupunta kami sa ilog para maligo kasama ang mga pinsan ko."},
  {"w0": 25, "w1": 35, "start": 10.415, "end": 14.603, "text": "Naglakad kami pauwi habang kumakain ng tinapay sa daan pauwi namin."},
  {"w0": 36, "w1": 47, "start": 15.046, "end": 19.615, "text": "Masarap talaga ang pandesal dito lalo na kapag mainit pa sa supot."},
  {"w0": 48, "w1": 60, "start": 20.062, "end": 25.01, "text": "Ang dami ng tao dito tuwing Sabado ng umaga sa may tabing dagat."},
  {"w0": 61, "w1": 70, "start": 25.462, "end": 29.272, "text": "Maaga kaming umalis kasi gusto naming makabili ng sariwang isda."},
  {"w0": 71, "w1": 83, "start": 32.308, "end": 37.251, "text": "Malamig ang tubig sa ilog pero ang ganda ng sikat ng araw ngayon."},
  {"w0": 84, "w1": 94, "start": 37.708, "end": 41.875, "text": "Nandito ako ngayon sa palengke malapit sa bahay namin sa probinsya."},
  {"w0": 95, "w1": 105, "start": 42.339, "end": 46.527, "text": "Naglakad kami pauwi habang kumakain ng tinapay sa daan pauwi namin."},
  {"w0": 106, "w1": 117, "start": 46.97, "end": 51.541, "text": "Pagkatapos kumain nagpahinga kami sa ilalim ng puno ng mangga sa likod."},
  {"w0": 118, "w1": 130, "start": 51.985, "end": 56.923, "text": "Simple lang ang buhay dito pero masaya ang lahat ng tao sa paligid."},
  {"w0": 131, "w1": 142, "start": 57.385, "end": 61.954, "text": "Masarap talaga ang pandesal dito lalo na kapag mainit pa sa supot."},
